{
  "realm": "paktay",
  "enabled": true,
  "displayName": "Paktay",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 28800,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 3,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(10) and digits(1) and upperCase(1) and lowerCase(1) and specialChars(1)",
  "roles": {
    "realm": [
      { "name": "USER", "description": "Usuario de Paktay" },
      { "name": "ADMIN", "description": "Administrador de Paktay" }
    ]
  },
  "clients": [
    {
      "clientId": "paktay-mobile",
      "name": "Paktay Mobile",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["paktay://oauth/callback"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "paktay-admin-panel",
      "name": "Paktay Admin Panel",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "bootstrap-secret-replaced-by-keycloak-init",
      "attributes": {
        "access.token.lifespan": "900",
        "client.session.idle.timeout": "1800",
        "client.session.max.lifespan": "28800"
      }
    },
    {
      "clientId": "paktay-auth-service",
      "name": "Paktay Auth Service",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "bootstrap-secret-replaced-by-keycloak-init"
    }
  ],
  "users": [
    {
      "username": "admin@paktay.local",
      "email": "admin@paktay.local",
      "firstName": "Paktay",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["ADMIN", "USER"]
    }
  ]
}
