{
  "info": {
    "name": "Paktay - Business Service",
    "description": "Colección completa de business-svc. Ejecuta primero el login de la colección Auth para llenar accessToken o adminToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Estado y documentación",
      "item": [
        { "name": "Healthcheck", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{businessUrl}}/actuator/health" } },
        { "name": "OpenAPI JSON", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{businessUrl}}/v3/api-docs" } }
      ]
    },
    {
      "name": "Entrada",
      "item": [
        { "name": "Ingresar a la aplicación", "request": { "method": "GET", "url": "{{businessUrl}}/api/v1/app/entry" } }
      ]
    },
    {
      "name": "Perfil de usuario",
      "item": [
        { "name": "Consultar mi perfil", "request": { "method": "GET", "url": "{{businessUrl}}/api/v1/user/profile" } },
        {
          "name": "Actualizar zona horaria y país",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"timezone\": \"America/Guayaquil\",\n  \"countryCode\": \"EC\"\n}" },
            "url": "{{businessUrl}}/api/v1/user/profile/context"
          }
        },
        {
          "name": "Subir o reemplazar avatar",
          "request": {
            "method": "PUT",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }] },
            "url": "{{businessUrl}}/api/v1/user/profile/avatar"
          }
        },
        { "name": "Eliminar avatar", "request": { "method": "DELETE", "url": "{{businessUrl}}/api/v1/user/profile/avatar" } }
      ]
    },
    {
      "name": "Catálogos",
      "item": [
        {
          "name": "Listar bancos",
          "request": { "method": "GET", "url": "{{businessUrl}}/api/v1/catalog/banks" },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) {", "  const banks = pm.response.json();", "  if (banks.length) pm.environment.set('bankId', banks[0].id);", "}"] } }]
        },
        {
          "name": "Listar categorías disponibles",
          "request": { "method": "GET", "url": "{{businessUrl}}/api/v1/user/categories" },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) {", "  const categories = pm.response.json();", "  if (categories.length) pm.environment.set('categoryId', categories[0].id);", "}"] } }]
        },
        {
          "name": "Crear categoría personal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{userCategoryName}}\"\n}" },
            "url": "{{businessUrl}}/api/v1/user/categories"
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.environment.set('categoryId', pm.response.json().id);"] } }]
        },
        {
          "name": "Crear categoría global (ADMIN)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{systemCategoryName}}\",\n  \"displayOrder\": 100\n}" },
            "url": "{{businessUrl}}/api/v1/admin/catalog/categories"
          }
        }
      ]
    },
    {
      "name": "Tarjetas",
      "item": [
        {
          "name": "Registrar tarjeta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"bankId\": \"{{bankId}}\",\n  \"cardType\": \"DEBIT\",\n  \"name\": \"{{cardName}}\",\n  \"last4\": \"{{cardLast4}}\",\n  \"colorDark\": \"#2563EB\",\n  \"colorLight\": \"#60A5FA\",\n  \"initialBudget\": 500.00,\n  \"currencyCode\": \"USD\"\n}" },
            "url": "{{businessUrl}}/api/v1/user/cards"
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.environment.set('cardId', pm.response.json().id);"] } }]
        },
        { "name": "Listar mis tarjetas", "request": { "method": "GET", "url": "{{businessUrl}}/api/v1/user/cards" } },
        { "name": "Desactivar tarjeta (sin consumos en 3 meses)", "request": { "method": "PATCH", "url": "{{businessUrl}}/api/v1/user/cards/{{cardId}}/deactivate" } },
        { "name": "Reactivar tarjeta", "request": { "method": "PATCH", "url": "{{businessUrl}}/api/v1/user/cards/{{cardId}}/activate" } },
        { "name": "Eliminar tarjeta (borrado lógico, sin consumos en 3 meses)", "request": { "method": "DELETE", "url": "{{businessUrl}}/api/v1/user/cards/{{cardId}}" } },
        {
          "name": "Asociar nombre de Wallet",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"walletName\": \"VISA MASTERCARD PLATINUM\"\n}" },
            "url": "{{businessUrl}}/api/v1/user/cards/{{cardId}}/wallet-name"
          }
        },
        { "name": "Quitar nombre de Wallet", "request": { "method": "DELETE", "url": "{{businessUrl}}/api/v1/user/cards/{{cardId}}/wallet-name" } }
      ]
    },
    {
      "name": "Gastos",
      "item": [
        {
          "name": "Registrar gasto manual",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"idempotencyKey\": \"{{$guid}}\",\n  \"cardId\": \"{{cardId}}\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"amount\": 12.50,\n  \"currencyCode\": \"USD\",\n  \"exchangeRateToUsd\": 1,\n  \"merchant\": \"Comercio de prueba\",\n  \"occurredAt\": \"{{$isoTimestamp}}\",\n  \"recurring\": false,\n  \"assignedByRule\": false\n}" },
            "url": "{{businessUrl}}/api/v1/user/expenses"
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.environment.set('expenseId', pm.response.json().id);"] } }]
        },
        {
          "name": "Listar mis gastos (paginado)",
          "request": {
            "method": "GET",
            "description": "Devuelve { items, nextCursor }. Para la página siguiente activa cursor (se llena solo con nextCursor) y repite los mismos filtros.",
            "url": { "raw": "{{businessUrl}}/api/v1/user/expenses?limit=50", "host": ["{{businessUrl}}"], "path": ["api", "v1", "user", "expenses"], "query": [{ "key": "limit", "value": "50" }, { "key": "cursor", "value": "{{expenseCursor}}", "disabled": true }, { "key": "from", "value": "{{expenseFrom}}", "disabled": true }, { "key": "to", "value": "{{expenseTo}}", "disabled": true }, { "key": "cardId", "value": "{{cardId}}", "disabled": true }, { "key": "categoryId", "value": "{{categoryId}}", "disabled": true }] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) {", "  const page = pm.response.json();", "  if (page.nextCursor) pm.environment.set('expenseCursor', page.nextCursor); else pm.environment.unset('expenseCursor');", "  if (page.items.length && !pm.environment.get('expenseId')) pm.environment.set('expenseId', page.items[0].id);", "}"] } }]
        },
        {
          "name": "Sincronizar gastos desde (since)",
          "request": {
            "method": "GET",
            "description": "Filas con updatedAt >= since, por updatedAt asc. Incluye VOIDED y REFUND. El cursor de esta consulta no sirve sin since.",
            "url": { "raw": "{{businessUrl}}/api/v1/user/expenses?since={{expenseSince}}&limit=200", "host": ["{{businessUrl}}"], "path": ["api", "v1", "user", "expenses"], "query": [{ "key": "since", "value": "{{expenseSince}}" }, { "key": "limit", "value": "200" }, { "key": "cursor", "value": "{{expenseSyncCursor}}", "disabled": true }] }
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["if (!pm.environment.get('expenseSince')) pm.environment.set('expenseSince', '2026-01-01T00:00:00Z');"] } },
            { "listen": "test", "script": { "exec": ["if (pm.response.code === 200) {", "  const page = pm.response.json();", "  if (page.nextCursor) pm.environment.set('expenseSyncCursor', page.nextCursor); else pm.environment.unset('expenseSyncCursor');", "}"] } }
          ]
        },
        { "name": "Consultar un gasto", "request": { "method": "GET", "url": "{{businessUrl}}/api/v1/user/expenses/{{expenseId}}" } },
        {
          "name": "Editar gasto",
          "request": {
            "method": "PUT",
            "description": "categoryId y cardId obligatorios. amount y merchantRaw opcionales, sólo en gastos MANUAL.",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"cardId\": \"{{cardId}}\",\n  \"amount\": 15.00,\n  \"merchantRaw\": \"Comercio corregido\"\n}" },
            "url": "{{businessUrl}}/api/v1/user/expenses/{{expenseId}}"
          }
        },
        {
          "name": "Anular gasto",
          "request": {
            "method": "POST",
            "description": "Devuelve { voided, refund }. Idempotente.",
            "url": "{{businessUrl}}/api/v1/user/expenses/{{expenseId}}/void"
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200 && pm.response.json().refund) pm.environment.set('refundExpenseId', pm.response.json().refund.id);"] } }]
        }
      ]
    },
    {
      "name": "Resumen",
      "item": [
        {
          "name": "Resumen del mes",
          "request": {
            "method": "GET",
            "description": "Resumen de la pantalla de inicio. month (YYYY-MM) es opcional: sin él, mes actual en la zona horaria del perfil. Mes futuro o mal formado = 400. Mes pasado: daysLeft = 0.",
            "url": { "raw": "{{businessUrl}}/api/v1/user/summary", "host": ["{{businessUrl}}"], "path": ["api", "v1", "user", "summary"], "query": [{ "key": "month", "value": "{{summaryMonth}}", "disabled": true }] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) {", "  const s = pm.response.json();", "  pm.test('daysLeft cuenta hoy (0 en un mes pasado)', () => { if (s.daysLeft > 0) pm.expect(s.daysLeft).to.eql(s.daysInMonth - s.dayOfMonth + 1); else pm.expect(s.dayOfMonth).to.eql(s.daysInMonth); });", "  pm.test('recent tiene como mucho 3 gastos', () => pm.expect(s.recent.length).to.be.at.most(3));", "}"] } }]
        }
      ]
    },
    {
      "name": "Dispositivos",
      "item": [
        {
          "name": "Registrar o actualizar dispositivo",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"platform\": \"ios\",\n  \"deviceName\": \"iPhone de prueba\",\n  \"biometricEnabled\": true\n}" },
            "url": "{{businessUrl}}/api/v1/security/devices/me"
          }
        },
        { "name": "Listar mis dispositivos", "request": { "method": "GET", "url": "{{businessUrl}}/api/v1/security/devices" } },
        { "name": "Eliminar dispositivo", "request": { "method": "DELETE", "url": "{{businessUrl}}/api/v1/security/devices/{{deviceId}}" } }
      ]
    }
  ]
}
