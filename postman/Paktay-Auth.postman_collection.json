{
  "info": {
    "name": "Paktay - Auth Service",
    "description": "Colección completa de auth-svc. Los logins guardan automáticamente accessToken o adminToken en el ambiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Estado y documentación",
      "item": [
        { "name": "Healthcheck", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{authUrl}}/actuator/health" } },
        { "name": "OpenAPI JSON", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{authUrl}}/v3/api-docs" } }
      ]
    },
    {
      "name": "Autenticación pública",
      "item": [
        {
          "name": "Configuración OAuth móvil",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{authUrl}}/api/v1/auth/oauth-config" }
        },
        {
          "name": "Registrar usuario",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"displayName\": \"Usuario Paktay\",\n  \"password\": \"{{userPassword}}\"\n}" },
            "url": "{{authUrl}}/api/v1/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) {", "  const body = pm.response.json();", "  pm.environment.set('userId', body.id);", "}"] } }]
        },
        {
          "name": "Login usuario (guarda accessToken)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" },
            "url": "{{authUrl}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login exitoso', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.environment.set('accessToken', pm.response.json().access_token);"] } }]
        },
        {
          "name": "Login admin (guarda adminToken)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{authUrl}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login admin exitoso', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.environment.set('adminToken', pm.response.json().access_token);"] } }]
        }
      ]
    },
    {
      "name": "Mi cuenta",
      "item": [
        {
          "name": "Cambiar mi contraseña",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{userPassword}}\",\n  \"newPassword\": \"{{newUserPassword}}\"\n}" },
            "url": "{{authUrl}}/api/v1/auth/password"
          }
        }
      ]
    },
    {
      "name": "Administración de usuarios",
      "item": [
        {
          "name": "Reemplazar contraseña de usuario",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"newPassword\": \"{{newUserPassword}}\",\n  \"temporary\": false\n}" },
            "url": "{{authUrl}}/api/v1/admin/users/{{userId}}/password"
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{authUrl}}/api/v1/admin/users/{{userId}}"
          }
        }
      ]
    }
  ]
}
