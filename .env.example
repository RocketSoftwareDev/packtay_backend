# Configuración única para docker-compose.yml (desarrollo o producción).
# Copia este archivo como .env y reemplaza todos los valores antes de iniciar servicios.

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-local-password
# El perfil identity-setup sincroniza este valor con paktay-auth-service.
KEYCLOAK_SERVICE_CLIENT_SECRET=replace-with-a-long-random-service-client-secret
# Duraciones en segundos. Para producción se recomienda reducir el access token.
KEYCLOAK_ACCESS_TOKEN_LIFESPAN=28800
KEYCLOAK_SSO_SESSION_IDLE_TIMEOUT=2592000
KEYCLOAK_SSO_SESSION_MAX_LIFESPAN=2592000
PAKTAY_ADMIN_EMAIL=admin@paktay.local
PAKTAY_ADMIN_PASSWORD=replace-with-a-long-local-app-admin-password
BUSINESS_DB_PASSWORD=replace-with-a-different-business-db-password
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-backend-only-secret-key
SUPABASE_AVATAR_BUCKET=avatars

# Cloudflare Tunnel (perfil opcional: docker compose --profile tunnel up -d).
# Crea un túnel administrado en Zero Trust y copia únicamente su token aquí.
CLOUDFLARE_TUNNEL_TOKEN=
# URLs de Keycloak Services: en producción usa el dominio HTTPS público.
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/paktay
# Orígenes web separados por comas. React Native nativo no necesita CORS (la app no se ve afectada).
# En producción: solo el dominio HTTPS del panel, p. ej. https://admin.tudominio.com
PAKTAY_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
# Web del formulario público de soporte (solo /api/v1/public/**). Vacío = los mismos del panel.
PAKTAY_CORS_PUBLIC_ORIGIN_PATTERNS=
# Cabecera X-Paktay-Client obligatoria en /api/v1/admin/** (la manda la web del panel).
PAKTAY_ADMIN_REQUIRE_CLIENT_HEADER=true
# Panel de administración (cliente Keycloak paktay-admin-web, PKCE).
# Sin barra final. En producción: el dominio HTTPS del panel, y agregarlo también
# a PAKTAY_CORS_ALLOWED_ORIGIN_PATTERNS. El token del panel dura menos que el móvil.
PAKTAY_ADMIN_WEB_URL=http://localhost:3000
PAKTAY_ADMIN_ACCESS_TOKEN_LIFESPAN=900
# Enlace del correo de confirmación de soporte. {token} se reemplaza. Por defecto apunta
# a business-svc, que responde una página simple; puede apuntar a la web del formulario.
SUPPORT_VERIFY_LINK=http://localhost:8082/api/v1/public/support/verify?token={token}

# SMTP compartido con WeSafeGo; completar solo en .env.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASS=
# Avisos push: ruta en esta máquina al .json de la cuenta de servicio de Firebase
# Vacía = no se envían avisos. Nunca guardar las credenciales en Git.
FIREBASE_CREDENTIALS_HOST_FILE=
# Remitente de los correos (p. ej. no-reply@paktay.app). Vacío = SMTP_USER.
SMTP_FROM=

# Proyecto, puertos y volumen: mantener el nombre del volumen al actualizar.
COMPOSE_PROJECT_NAME=packtay_backend
API_BIND_ADDRESS=127.0.0.1
AUTH_PORT=8081
BUSINESS_PORT=8082
BUSINESS_DB_PORT=5433
# Vacío usa <COMPOSE_PROJECT_NAME>_business-data.
BUSINESS_DATA_VOLUME=
# Keycloak Services se administra fuera de este repositorio.
SHARED_KEYCLOAK_INTERNAL_URL=http://host.docker.internal:8180
