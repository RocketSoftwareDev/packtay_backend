# Desarrollo local con docker-compose.yml.
# Copia este archivo como .env y reemplaza todos los valores antes de iniciar servicios.

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-local-password
KEYCLOAK_DB_PASSWORD=replace-with-a-different-local-db-password
# keycloak-init sincroniza este valor con el cliente paktay-auth-service.
KEYCLOAK_SERVICE_CLIENT_SECRET=replace-with-a-long-random-service-client-secret
# Duraciones en segundos. Para producción se recomienda reducir el access token.
KEYCLOAK_ACCESS_TOKEN_LIFESPAN=28800
KEYCLOAK_SSO_SESSION_IDLE_TIMEOUT=2592000
KEYCLOAK_SSO_SESSION_MAX_LIFESPAN=2592000
PAKTAY_ADMIN_EMAIL=admin@paktay.local
PAKTAY_ADMIN_PASSWORD=replace-with-a-long-local-app-admin-password
BUSINESS_DB_PASSWORD=replace-with-a-different-business-db-password
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-backend-only-secret-key
SUPABASE_AVATAR_BUCKET=avatars

# Cloudflare Tunnel (perfil opcional: docker compose --profile tunnel up -d).
# Crea un túnel administrado en Zero Trust y copia únicamente su token aquí.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
# URLs públicas elegidas para el túnel. Deben usar un dominio administrado en Cloudflare.
KEYCLOAK_PUBLIC_URL=https://login.example.com
KEYCLOAK_ISSUER_URI=https://login.example.com/realms/paktay
# Orígenes web separados por comas. React Native nativo no necesita CORS.
PAKTAY_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# Producción (Render): estas variables se crean en el panel de Render, no en Git.
# KEYCLOAK_PUBLIC_URL=https://<keycloak-service>.onrender.com
# KEYCLOAK_INTERNAL_URL=https://<keycloak-service>.onrender.com
# KEYCLOAK_ISSUER_URI=https://<keycloak-service>.onrender.com/realms/paktay
# KEYCLOAK_JWK_SET_URI=https://<keycloak-service>.onrender.com/realms/paktay/protocol/openid-connect/certs
# KEYCLOAK_HEALTH_URL=https://<keycloak-service>.onrender.com/realms/paktay
# BUSINESS_DB_URL=jdbc:postgresql://<supabase-host>:<port>/<database>?sslmode=require
# BUSINESS_DB_USERNAME=<supabase-database-user>
# BUSINESS_DB_PASSWORD=<supabase-database-password>
# FLYWAY_ENABLED=false
# KC_DB_URL=jdbc:postgresql://<render-keycloak-db-host>:5432/<database>
# KC_DB_USERNAME=<render-keycloak-db-user>
# KC_DB_PASSWORD=<render-keycloak-db-password>
