# Desarrollo local con docker-compose.yml.
# Copia este archivo como .env y reemplaza todos los valores antes de iniciar servicios.

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-local-password
KEYCLOAK_DB_PASSWORD=replace-with-a-different-local-db-password
KEYCLOAK_SERVICE_CLIENT_SECRET=replace-with-a-long-service-client-secret
BUSINESS_DB_PASSWORD=replace-with-a-different-business-db-password

# Producción (Render): estas variables se crean en el panel de Render, no en Git.
# KEYCLOAK_PUBLIC_URL=https://<keycloak-service>.onrender.com
# KEYCLOAK_INTERNAL_URL=https://<keycloak-service>.onrender.com
# KEYCLOAK_ISSUER_URI=https://<keycloak-service>.onrender.com/realms/paktay
# KEYCLOAK_JWK_SET_URI=https://<keycloak-service>.onrender.com/realms/paktay/protocol/openid-connect/certs
# KEYCLOAK_HEALTH_URL=https://<keycloak-service>.onrender.com/realms/paktay
# BUSINESS_DB_URL=jdbc:postgresql://<supabase-host>:<port>/<database>?sslmode=require
# BUSINESS_DB_USERNAME=<supabase-database-user>
# BUSINESS_DB_PASSWORD=<supabase-database-password>
# FLYWAY_ENABLED=false
# KC_DB_URL=jdbc:postgresql://<render-keycloak-db-host>:5432/<database>
# KC_DB_USERNAME=<render-keycloak-db-user>
# KC_DB_PASSWORD=<render-keycloak-db-password>
