# Configuración única para docker-compose.yml (desarrollo o producción).
# Copia este archivo como .env y reemplaza todos los valores antes de iniciar servicios.

KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
# El perfil identity-setup sincroniza este valor con paktay-auth-service.
KEYCLOAK_SERVICE_CLIENT_SECRET=
# Duraciones en segundos. Para producción se recomienda reducir el access token.
KEYCLOAK_ACCESS_TOKEN_LIFESPAN=
KEYCLOAK_SSO_SESSION_IDLE_TIMEOUT=
KEYCLOAK_SSO_SESSION_MAX_LIFESPAN=
PAKTAY_ADMIN_EMAIL=
PAKTAY_ADMIN_PASSWORD=
BUSINESS_DB_PASSWORD=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_AVATAR_BUCKET=

# Cloudflare Tunnel (perfil opcional: docker compose --profile tunnel up -d).
# Crea un túnel administrado en Zero Trust y copia únicamente su token aquí.
CLOUDFLARE_TUNNEL_TOKEN=
# URLs de Keycloak Services: en producción usa el dominio HTTPS público.
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_ISSUER_URI=
# Orígenes web separados por comas. React Native nativo no necesita CORS (la app no se ve afectada).
# El panel llama a la API desde su servidor (BFF), no desde el navegador: en producción no
# necesita estar aquí. Deja solo lo que de verdad llame desde un navegador.
PAKTAY_CORS_ALLOWED_ORIGIN_PATTERNS=
# Web del formulario público de soporte (solo /api/v1/public/**). Vacío = los mismos de arriba.
PAKTAY_CORS_PUBLIC_ORIGIN_PATTERNS=
# Panel de administración: login propio (la web no muestra Keycloak) con el cliente
# confidencial paktay-admin-panel. El secreto lo sincroniza identity-setup y solo lo usa auth-svc.
KEYCLOAK_ADMIN_PANEL_CLIENT_SECRET=
# /api/v1/admin/** exige la cabecera X-Paktay-Client y un token de ese cliente (azp).
PAKTAY_ADMIN_REQUIRE_CLIENT_HEADER=
PAKTAY_ADMIN_REQUIRE_PANEL_TOKEN=
# Segundos: access token del panel, sesión inactiva y sesión máxima.
PAKTAY_ADMIN_ACCESS_TOKEN_LIFESPAN=
PAKTAY_ADMIN_SESSION_IDLE_TIMEOUT=
PAKTAY_ADMIN_SESSION_MAX_LIFESPAN=
# Enlace del correo de confirmación de soporte. {token} se reemplaza. Por defecto apunta
# a business-svc, que responde una página simple; puede apuntar a la web del formulario.
SUPPORT_VERIFY_LINK=

# Correo de Gmail por SMTP; completar solo en .env con una contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_STARTTLS=
SMTP_USER=
SMTP_PASS=
# Avisos push: ruta en esta máquina al .json de la cuenta de servicio de Firebase
# Vacía = no se envían avisos. Nunca guardar las credenciales en Git.
FIREBASE_CREDENTIALS_HOST_FILE=
# Remitente de los correos (p. ej. no-reply@paktay.app). Vacío = SMTP_USER.
SMTP_FROM=

# Proyecto, puertos y volumen: mantener el nombre del volumen al actualizar.
COMPOSE_PROJECT_NAME=
API_BIND_ADDRESS=
AUTH_PORT=
BUSINESS_PORT=
BUSINESS_DB_PORT=
# Vacío usa <COMPOSE_PROJECT_NAME>_business-data.
BUSINESS_DATA_VOLUME=
# Keycloak Services se administra fuera de este repositorio.
SHARED_KEYCLOAK_INTERNAL_URL=
