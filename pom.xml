<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>
    <groupId>ec.paktay</groupId>
    <artifactId>paktay-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Paktay Backend</name>
    <modules>
        <module>auth-svc</module>
        <module>business-svc</module>
    </modules>
    <properties>
        <java.version>17</java.version>
        <!-- Base vacía para @{argLine} de surefire (otros plugins, como JaCoCo, la pueden completar). -->
        <argLine></argLine>
    </properties>
    <!--
      Mockito se carga como agente al arrancar las pruebas. Sin esto intenta engancharse a la
      JVM en caliente, lo que los JDK nuevos restringen y el entorno de Codex en la Mac bloquea
      ("JDK does not supply a working agent attachment mechanism", corrida 2026-09-26_1005).
      Es la configuración que recomienda Mockito 5 para JDK 21 o superior.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ruta-de-dependencias</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

