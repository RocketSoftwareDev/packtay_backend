# Plantilla de producción. Copiar al archivo .env del VPS y completar secretos.
COMPOSE_PROJECT_NAME=paktay-prod
API_BIND_ADDRESS=127.0.0.1
AUTH_PORT=8081
BUSINESS_PORT=8082
BUSINESS_DB_PORT=5433
BUSINESS_DATA_VOLUME=packtay_backend_business-data

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REEMPLAZAR
KEYCLOAK_SERVICE_CLIENT_SECRET=REEMPLAZAR
KEYCLOAK_ADMIN_PANEL_CLIENT_SECRET=REEMPLAZAR
KEYCLOAK_PUBLIC_URL=https://keycloak.rocketsoftwarecore.com
KEYCLOAK_ISSUER_URI=https://keycloak.rocketsoftwarecore.com/realms/paktay
SHARED_KEYCLOAK_INTERNAL_URL=https://keycloak.rocketsoftwarecore.com

PAKTAY_ADMIN_EMAIL=REEMPLAZAR
PAKTAY_ADMIN_PASSWORD=REEMPLAZAR
PAKTAY_ADMIN_REQUIRE_CLIENT_HEADER=true
PAKTAY_ADMIN_REQUIRE_PANEL_TOKEN=true
PAKTAY_CORS_ALLOWED_ORIGIN_PATTERNS=https://admin.rocketsoftwarecore.com
PAKTAY_CORS_PUBLIC_ORIGIN_PATTERNS=https://support.rocketsoftwarecore.com

BUSINESS_DB_PASSWORD=REEMPLAZAR
SUPABASE_URL=https://REEMPLAZAR.supabase.co
SUPABASE_SECRET_KEY=REEMPLAZAR
SUPABASE_AVATAR_BUCKET=avatars

SMTP_HOST=REEMPLAZAR
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USER=REEMPLAZAR
SMTP_PASS=REEMPLAZAR
SMTP_FROM=no-reply@rocketsoftwarecore.com
SUPPORT_VERIFY_LINK=https://support.rocketsoftwarecore.com/verify?token={token}

FIREBASE_CREDENTIALS_HOST_FILE=/opt/paktay/secrets/firebase-admin.json
CLOUDFLARE_TUNNEL_TOKEN=REEMPLAZAR
